# Configure the Flywheel CLI first:
# npx --yes @paradigma-inc/flywheel setup --mode cli
# flywheel auth:status

# Optional: attach the first demo run under an existing Flywheel project/root node.
FLYWHEEL_ROOT_NODE_ID=$env:FLYWHEEL_ROOT_NODE_ID="3c19a418-0358-5c1c-a875-388f59aa3fea"

# By default, later Flywheel runs attach under the previous run's accepted audit node.
# Set to 0 to attach every run directly under FLYWHEEL_ROOT_NODE_ID.
FLYWHEEL_CHAIN_FROM_LAST_ACCEPTED=1

# Optional repo context recorded on each created node.
FLYWHEEL_UPDATED_BY=MetricGuard
FLYWHEEL_REPO_URL=https://github.com/muradhuseynov1/MetricGuard.git
FLYWHEEL_BRANCH_NAME=main
FLYWHEEL_HEAD_COMMIT_SHA=
FLYWHEEL_ORIGIN_HOST=local-script
FLYWHEEL_EXTERNAL_TRANSCRIPT_REF=

# Optional LLM judge explanation. The deterministic audit still controls verdicts.
OPENAI_API_KEY=
METRICGUARD_LLM_JUDGE=1
METRICGUARD_LLM_JUDGE_MODEL=gpt-5.5
METRICGUARD_LLM_JUDGE_TIMEOUT_SECONDS=30
