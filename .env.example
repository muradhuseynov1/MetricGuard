FLYWHEEL_ROOT_NODE_ID=replace-with-your-flywheel-root-node-id

FLYWHEEL_API_BASE_URL=https://your-flywheel-api.example.com
FLYWHEEL_API_TOKEN=replace-with-your-flywheel-api-token
FLYWHEEL_PROJECT_ID=replace-with-your-flywheel-project-id

# Defaults assume generic graph endpoints. Override these to match Flywheel docs.
FLYWHEEL_NODES_PATH=/nodes
FLYWHEEL_EDGES_PATH=/edges
FLYWHEEL_TIMEOUT_SECONDS=20
